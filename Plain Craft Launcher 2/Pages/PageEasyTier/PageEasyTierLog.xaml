<local:MyPageRight
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     mc:Ignorable="d" x:Class="PageEasyTierLog">
    <Grid Margin="25,10,25,10">
        <local:MyCard x:Name="CardLog" Margin="0,10,0,10" Title="运行日志">
            <Grid Margin="25,42,25,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <local:MyButton x:Name="BtnClear" Text="清空显示" MinWidth="86" Height="30" Margin="0,0,10,0" />
                    <local:MyButton x:Name="BtnCopy" Text="复制全部" MinWidth="86" Height="30" Margin="0,0,10,0" />
                    <local:MyButton x:Name="BtnOpenDir" Text="打开日志目录" MinWidth="110" Height="30" />
                    <TextBlock x:Name="LabLogCount" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource ColorBrushGray3}" FontSize="12" />
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource ColorBrush8}" CornerRadius="4" Padding="10">
                    <ScrollViewer x:Name="PanLog" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LabLog" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
